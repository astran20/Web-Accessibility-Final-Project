gLeft=0;spacingRight=0;spacingTop=0;spacingBottom=0;strokeColor=none;fillColor=none;" vertex="1" parent="screen-5"><mxGeometry x="951.0" y="1921.3" width="135.4" height="20.0" as="geometry"/></mxCell><mxCell id="screen-126" value="" style="shape=image;html=1;imageAspect=0;image=data:image/svg+xml,;" vertex="1" parent="screen-5"><mxGeometry x="1090.4" y="1923.3" width="14.0" height="14.0" as="geometry"/></mxCell><mxCell id="screen-127" value="" style="rounded=1;absoluteArcSize=1;arcSize=52;whiteSpace=wrap;html=1;fillColor=#243C32;strokeColor=none;strokeWidth=1;shadow=1;" vertex="1" parent="screen-5"><mxGeometry x="1000.0" y="1912.0" width="232.0" height="52.0" as="geometry"/></mxCell><mxCell id="screen-128" value="" style="shape=image;html=1;imageAspect=0;image=data:image/svg+xml,;" vertex="1" parent="screen-5"><mxGeometry x="1018.0" y="1927.0" width="22.0" height="22.0" as="geometry"/></mxCell><mxCell id="screen-129" value="Ask the style assistant" style="text;html=1;whiteSpace=wrap;overflow=visible;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=14;fontColor=#F6F3EC;fontStyle=1;spacing=0;spacingLeft=0;spacingRight=0;spacingTop=0;spacingBottom=0;strokeColor=none;fillColor=none;" vertex="1" parent="screen-5"><mxGeometry x="1050.0" y="1912.0" width="180.0" height="52.0" as="geometry"/></mxCell><mxCell id="screen-130" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#D5CFC3;strokeColor=none;strokeWidth=1;" vertex="1" parent="screen-5"><mxGeometry x="0.0" y="2008.0" width="1280.0" height="1.0" as="geometry"/></mxCell><mxCell id="screen-131" value="&lt;div style=&quot;letter-spacing:2.6px;&quot;&gt;RETHREAD&lt;span style=&quot;color:#A66B45&quot;&gt;.&lt;/span&gt;&lt;/div&gt;" style="text;html=1;whiteSpace=wrap;overflow=visible;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=15;fontColor=#345746;fontStyle=1;spacing=0;spacingLeft=0;spacingRight=0;spacingTop=0;spacingBottom=0;strokeColor=none;fillColor=none;" vertex="1" parent="screen-5"><mxGeometry x="48.0" y="2008.0" width="140.0" height="92.0" as="geometry"/></mxCell><mxCell id="screen-132" value="Find your next favorite, close to home." style="text;html=1;whiteSpace=wrap;overflow=visible;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=14;fontColor=#4F5A53;fontStyle=0;spacing=0;spacingLeft=0;spacingRight=0;spacingTop=0;spacingBottom=0;strokeColor=none;fillColor=none;" vertex="1" parent="screen-5"><mxGeometry x="190.0" y="2008.0" width="400.0" height="92.0" as="geometry"/></mxCell><mxCell id="screen-133" value="Classroom prototype · Sample listings only" style="text;html=1;whiteSpace=wrap;overflow=visible;align=right;verticalAlign=middle;fontFamily=Arial;fontSize=12.5;fontColor=#4F5A53;fontStyle=0;spacing=0;spacingLeft=0;spacingRight=0;spacingTop=0;spacingBottom=0;strokeColor=none;fillColor=none;" vertex="1" parent="screen-5"><mxGeometry x="872.0" y="2008.0" width="360.0" height="92.0" as="geometry"/></mxCell><mxCell id="screen-134" value="&lt;b&gt;From lo-fi:&lt;/b&gt; filters moved from a left sidebar into one row above the grid so the 4-column grid stays wide. The result count sits right under the filters, so you can see it change.&lt;br&gt;&lt;br&gt;&lt;b&gt;Added:&lt;/b&gt; the sustainability band (the brief says it has to be visible on the site), a saved-count badge on Favorites in the nav, and the style assistant button bottom-right, where the lo-fi marked the chat box." style="shape=note;size=16;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;align=left;verticalAlign=top;spacing=14;fontFamily=Arial;fontSize=14;fontColor=#3D3420;" vertex="1" parent="1"><mxGeometry x="0.0" y="2130.0" width="600.0" height="210.0" as="geometry"/></mxCell><mxCell id="screen-135" value="&lt;b&gt;Nav:&lt;/b&gt; adds an &lt;b&gt;Appointments&lt;/b&gt; link. The coded site has no appointments page yet, but interaction 5 needs one (see board 5).&lt;br&gt;&lt;br&gt;&lt;b&gt;Hearts:&lt;/b&gt; filled green = saved (3 here). They match the Favorites page and the count badge." style="shape=note;size=16;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;align=left;verticalAlign=top;spacing=14;fontFamily=Arial;fontSize=14;fontColor=#3D3420;" vertex="1" parent="1"><mxGeometry x="620.0" y="2130.0" width="600.0" height="210.0" as="geometry"/></mxCell><mxCell id="screen-136" value="1b · Explore: no results" style="text;html=1;whiteSpace=wrap;overflow=visible;align=left;verticalAlign=top;fontFamily=Georgia;fontSize=26;fontColor=#1D1D1B;fontStyle=0;spacing=0;spacingLeft=0;spacingRight=0;spacingTop=0;spacingBottom=0;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="1440.0" y="-64.0" width="1280.0" height="34.0" as="geometry"/></mxCell><mxCell id="screen-137" value="index.html · interaction 1, empty state" style="text;html=1;whiteSpace=wrap;overflow=visible;align=left;verticalAlign=top;fontFamily=Arial;fontSize=13;fontColor=#6B6B66;fontStyle=0;spacing=0;spacingLeft=0;spacingRight=0;spacingTop=0;spacingBottom=0;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="1440.0" y="-30.0" width="1280.0" height="20.0" as="geometry"/></mxCell><mxCell id="screen-138" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F6F3EC;strokeColor=#C9C2B5;strokeWidth=1;container=1;collapsible=0;recursiveResize=0;shadow=1;" vertex="1" parent="1"><mxGeometry x="1440.0" y="0.0" width="1280.0" height="1060.0" as="geometry"/></mxCell><mxCell id="screen-139" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F6F3EC;strokeColor=none;strokeWidth=1;" vertex="1" parent="screen-138"><mxGeometry x="0.0" y="0.0" width="1280.0" height="78.0" as="geometry"/></mxCell><mxCell id="screen-140" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#D5CFC3;strokeColor=none;strokeWidth=1;" vertex="1" parent="screen-138"><mxGeometry x="0.0" y="77.0" width="1280.0" height="1.0" as="geometry"/></mxCell><mxCell id="screen-141" value="&lt;div style=&quot;letter-spacing:3.4px;&quot;&gt;RETHREAD&lt;span s