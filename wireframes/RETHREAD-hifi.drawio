ometry"/></mxCell><mxCell id="screen-641" value="What our demo does" style="text;html=1;whiteSpace=wrap;overflow=visible;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=13;fontColor=#F6F3EC;fontStyle=1;spacing=0;spacingLeft=0;spacingRight=0;spacingTop=0;spacingBottom=0;strokeColor=none;fillColor=none;" vertex="1" parent="screen-566"><mxGeometry x="286.0" y="1480.0" width="430.0" height="48.0" as="geometry"/></mxCell><mxCell id="screen-642" value="What a real version would need" style="text;html=1;whiteSpace=wrap;overflow=visible;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=13;fontColor=#F6F3EC;fontStyle=1;spacing=0;spacingLeft=0;spacingRight=0;spacingTop=0;spacingBottom=0;strokeColor=none;fillColor=none;" vertex="1" parent="screen-566"><mxGeometry x="746.0" y="1480.0" width="474.0" height="48.0" as="geometry"/></mxCell><mxCell id="screen-643" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FBF9F6;strokeColor=#D5CFC3;strokeWidth=1;" vertex="1" parent="screen-566"><mxGeometry x="48.0" y="1528.0" width="1184.0" height="48.0" as="geometry"/></mxCell><mxCell id="screen-644" value="Your body" style="text;html=1;whiteSpace=wrap;overflow=visible;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=13.5;fontColor=#243C32;fontStyle=1;spacing=0;spacingLeft=0;spacingRight=0;spacingTop=0;spacingBottom=0;strokeColor=none;fillColor=none;" vertex="1" parent="screen-566"><mxGeometry x="66.0" y="1528.0" width="190.0" height="48.0" as="geometry"/></mxCell><mxCell id="screen-645" value="Four illustrated sample models, sizes S to XL." style="text;html=1;whiteSpace=wrap;overflow=visible;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=13.5;fontColor=#345746;fontStyle=0;spacing=0;spacingLeft=0;spacingRight=0;spacingTop=0;spacingBottom=0;strokeColor=none;fillColor=none;" vertex="1" parent="screen-566"><mxGeometry x="286.0" y="1528.0" width="430.0" height="48.0" as="geometry"/></mxCell><mxCell id="screen-646" value="Your camera or photo, body