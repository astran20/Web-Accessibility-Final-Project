ue="" style="shape=image;html=1;imageAspect=0;image=data:image/svg+xml,;strokeColor=none;" vertex="1" parent="screen-275"><mxGeometry x="463.0" y="1662.0" width="110.0" height="220.0" as="geometry"/></mxCell><mxCell id="screen-404" value="" style="shape=image;html=1;imageAspect=0;image=data:image/jpeg,;strokeColor=none;" vertex="1" parent="screen-275"><mxGeometry x="594.0" y="1662.0" width="60.0" height="80.0" as="geometry"/></mxCell><mxCell id="screen-405" value="&lt;div style=&quot;line-height:1.4;&quot;&gt;Brown Leather Jacket (M) · likely a good fit&lt;/div&gt;" style="text;html=1;whiteSpace=wrap;overflow=visible;align=left;verticalAlign=top;fontFamily=Arial;fontSize=12.5;fontColor=#4F5A53;fontStyle=0;spacing=0;spacingLeft=0;spacingRight=0;spacingTop=0;spacingBottom=0;strokeColor=none;fillColor=none;" vertex="1" parent="screen-275"><mxGeometry x="382.0" y="1900.0" width="272.0" height="50.0" as="geometry"/></mxCell><mxCell id="screen-406" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E9E3D7;strokeColor=none;strokeWidth=1;" vertex="1" parent="screen-275"><mxGeometry x="700.0" y="1624.0" width="532.0" height="200.0" as="geometry"/></mxCell><mxCell id="screen-407" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#A66B45;strokeColor=none;strokeWidth=1;" vertex="1" parent="screen-275"><mxGeometry x="700.0" y="1624.0" width="4.0" height="200.0" as="geometry"/></mxCell><mxCell id="screen-408" value="" style="shape=image;html=1;imageAspect=0;image=data:image/svg+xml,;" vertex="1" parent="screen-275"><mxGeometry x="726.0" y="1648.0" width="24.0" height="24.0" as="geometry"/></mxCell><mxCell id="screen-409" value="Your image stays yours." style="text;html=1;whiteSpace=wrap;overflow=visible;align=left;verticalAlign=top;fontFamily=Georgia;fontSize=24;fontColor=#243C32;fontStyle=0;spacing=0;spacingLeft=0;spacingRight=0;spacingTop=0;spacingBottom=0;strokeColor=none;fillColor=none;" vertex="1" parent="screen-275"><mxGeometry x="762.0" y="1644.0" width="440.0" height="34.0" as="geometry"/></mxCell><mxCell id="screen-410" value="&lt;div style=&quot;line-height:1.55;&quot;&gt;This demo does not use a camera, ask for a photo, upload an image, or connect to an AI service. The fit estimate only compares the listed size with the sample model’s size.&lt;/div&gt;" style="text;html=1;whiteSpace=wrap;overflow=visible;align=left;verticalAlign=top;fontFamily=Arial;fontSize=13.5;fontColor=#4F5A53;fontStyle=0;spacing=0;spacingLeft=0;spacingRight=0;spacingTop=0;spacingBottom=0;strokeColor=none;fillColor=none;" vertex="1" parent="screen-275"><mxGeometry x="726.0" y="1690.0" width="480.0" height="120.0" as="geometry"/></mxCell><mxCell id="screen-411" value="" style="rounded=1;absoluteArcSize=1;arcSize=52;whiteSpace=wrap;html=1;fillColor=#243C32;strokeColor=none;strokeWidth=1;shadow=1;" vertex="1" parent="screen-275"><mxGeometry x="1000.0" y="1960.0" width="232.0" height="52.0" as="geometry"/></mxCell><mxCell id="screen-412" value="" style="shape=image;html=1;imageAspect=0;image=data:image/svg+xml,;" vertex="1" parent="screen-275"><mxGeometry x="1018.0" y="1975.0" width="22.0" height="22.0" as="geometry"/></mxCell><mxCell id="screen-413" value="Ask the style assistant" style="text;html=1;whiteSpace=wrap;overflow=visible;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=14;fontColor=#F6F3EC;fontStyle=1;spacing=0;spacingLeft=0;spacingRight=0;spacingTop=0;spacingBottom=0;strokeColor=none;fillColor=none;" vertex="1" parent="screen-275"><mxGeometry x="1050.0" y="1960.0" width="180.0" height="52.0" as="geometry"/></mxCell><mxCell id="screen-414" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#D5CFC3;strokeColor=none;strokeWidth=1;" vertex="1" parent="screen-275"><mxGeometry x="0.0" y="2068.0" width="1280.0" height="1.0" as="geometry"/></mxCell><mxCell id="screen-415" value="&lt;div style=&quot;letter-spacing:2.6px;&quot;&gt;RETHREAD&lt;span style=&quot;color:#A66B45&quot;&gt;.&lt;/span&gt;&lt;/div&gt;" style="text;html=1;whiteSpace=wrap;overflow=visible;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=15;fontColor=#345746;fontStyle=1;spacing=0;spacingLeft=0;spacingRight=0;spacingTop=0;spacingBottom=0;strokeColor=none;fillColor=none;" vertex="1" parent="screen-275"><mxGeometry x="48.0" y="2068.0" width="140.0" height="92.0" as="geometry"/></mxCell><mxCell id="screen-416" value="Find your next favorite, close to home." style="text;html=1;whiteSpace=wrap;overflow=visible;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=14;fontColor=#4F5A53;fontStyle=0;spacing=0;spacingLeft=0;spacingRight=0;spacingTop=0;spacingBottom=0;strokeColor=none;fillColor=none;" vertex="1" parent="screen-275"><mxGeometry x="190.0" y="2068.0" width="400.0" height="92.0" as="geometry"/></mxCell><mxCell id="screen-417" value="Classroom prototype · Sample listings only" style="text;html=1;whiteSpace=wrap;overflow=visible;align=right;verticalAlign=middle;fontFamily=Arial;fontSize=12.5;fontColor=#4F5A53;fontStyle=0;spacing=0;spacingLeft=0;spacingRight=0;spacingTop=0;spacingBottom=0;strokeColor=none;fillColor=none;" vertex="1" parent="screen-275"><mxGeometry x="872.0" y="2068.0" width="360.0" height="92.0" as="geometry"/></mxCell><mxCell id="screen-418" value="&lt;b&gt;From lo-fi:&lt;/b&gt; same 1-2-3 steps. The DEMO label became the caramel “Simulated demo” notice at the top, plus a SIMULATED tag on the preview, so the label stays in view while you use it.&lt;br&gt;&lt;br&gt;&lt;b&gt;Added:&lt;/b&gt; a check mark on the selected model and piece (it does not rely on the green border alone), a Favorites / All items switch, and a privacy note. The compare strip from the lo-fi became Pin to compare." style="shape=note;size=16;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;align=left;verticalAlign=top;spacing=14;fontFamily=Arial;fontSize=14;fontColor=#3D3420;" vertex="1" parent="1"><mxGeometry x="4320.0" y="2190.0" width="600.0" height="230.0" as="geometry"/></mxCell><mxCell id="screen-419" value="&lt;b&gt;Preview art:&lt;/b&gt; tryon.js draws the garment on the figure in the browser. This board shows the bare model plus the listing photo. Take a screenshot of the live page to use in the final PDF." style="shape=note;size=16;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;align=left;verticalAlign=top;spacing=14;fontFamily=Arial;fontSize=14;fontColor=#3D3420;" vertex="1" parent="1"><mxGeometry x="4940.0" y="2190.0" width="600.0" height="140.0" as="geometry"/></mxCell><mxCell id="screen-420" value="4 · Book an in-store try-on (error state)" style="text;html=1;whiteSpace=wrap;overflow=visible;align=left;verticalAlign=top;fontFamily=Georgia;fontSize=26;fontColor=#1D1D1B;fontStyle=0;spacing=0;spacingLeft=0;spacingRight=0;spacingTop=0;spacingBottom=0;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="5760.0" y="-64.0" width="1280.0" height="34.0" as="geometry"/></mxCell><mxCell id="screen-421" value="booking.html · interaction 4" style="text;html=1;whiteSpace=wrap;overflow=visible;align=left;verticalAlign=top;fontFamily=Arial;fontSize=13;fontColor=#6B6B66;fontStyle=0;spacing=0;spacingLeft=0;spacingRight=0;spacingTop=0;spacingBottom=0;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="5760.0" y="-30.0" width="1280.0" height="20.0" as="geometry"/></mxCell><mxCell id="screen-422" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F6F3EC;strokeColor=#C9C2B5;strokeWidth=1;container=1;collapsible=0;recursiveResize=0;shadow=1;" vertex="1" parent="1"><mxGeometry x="5760.0" y="0.0" width="1280.0" height="1240.0" as="geometry"/></mxCell><mxCell id="screen-423" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F6F3EC;strokeColor=none;strokeWidth=1;" vertex="1" parent="screen-422"><mxGeometry x="0.0" y="0.0" width="1280.0" height="78.0" as="geometry"/></mxCell><mxCell id="screen-424" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#D5CFC3;strokeColor=none;strokeWidth=1;" vertex="1" pare