tments" style="text;html=1;whiteSpace=wrap;overflow=visible;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=14.5;fontColor=#243C32;fontStyle=0;spacing=0;spacingLeft=0;spacingRight=0;spacingTop=0;spacingBottom=0;strokeColor=none;fillColor=none;" vertex="1" parent="screen-566"><mxGeometry x="1013.2" y="0.0" width="94.4" height="78.0" as="geometry"/></mxCell><mxCell id="screen-576" value="How It Works" style="text;html=1;whiteSpace=wrap;overflow=visible;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=14.5;fontColor=#345746;fontStyle=1;spacing=0;spacingLeft=0;spacingRight=0;spacingTop=0;spacingBottom=0;strokeColor=none;fillColor=none;" vertex="1" parent="screen-566"><mxGeometry x="1139.6" y="0.0" width="94.4" height="78.0" as="geometry"/></mxCell><mxCell id="screen-577" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#345746;strokeColor=none;strokeWidth=1;" vertex="1" parent="screen-566"><mxGeometry x="1139.6" y="52.0" width="92.4" height="2.0" as="geometry"/></mxCell><mxCell id="screen-578" value="&lt;div style=&quot;letter-spacing:1.5px;&quot;&gt;THE TECH BEHIND THE DEMO&lt;/div&gt;" style="text;html=1;whiteSpace=wrap;overflow=visible;align=left;verticalAlign=top;fontFamily=Arial;fontSize=11.5;fontColor=#345746;fontStyle=1;spacing=0;spacingLeft=0;spacingRight=0;spacingTop=0;spacingBottom=0;strokeColor=none;fillColor=none;" vertex="1" parent="screen-566"><mxGeometry x="48.0" y="110.0" width="500.0" height="16.0" as="geometry"/></mxCell><mxCell id="screen-579" value="&lt;div style=&quot;line-height:1.05;&quot;&gt;How virtual try-on works.&lt;/div&gt;" style="text;html=1;whiteSpace=wrap;overflow=visible;align=left;verticalAlign=top;fontFamily=Georgia;fontSize=56;fontColor=#243C32;fontStyle=0;spacing=0;spacingLeft=0;spacingRight=0;spacingTop=0;spacingBottom=0;strokeColor=none;fillColor=none;" vertex="1" parent="screen-566"><mxGeometry x="48.0" y="136.0" width="900.0" height="68.4" as="geometry"/></mxCell><mxCell id="screen-580" value="&lt;div style=&quot;line-height:1.55;&quot;&gt;AR and AI can show how a piece might look on you before you leave home. Here is how the real technology works, what our demo imitates, and why it matters for secondhand fashion.&lt;/div&gt;" style="text;html=1;whiteSpace=wrap;overflow=visible;align=left;verticalAlign=top;fontFamily=Arial;fontSize=16;fontColor=#4F5A53;fontStyle=0;spacing=0;spacingLeft=0;spacingRight=0;spacingTop=0;spacingBottom=0;strokeColor=none;fillColor=none;" vertex="1" parent="screen-566"><mxGeometry x="48.0" y="218.4" width="820.0" height="48.0" as="geometry"/></mxCell><mxCell id="screen-581" value="&lt;div style=&quot;letter-spacing:1.5px;&quot;&gt;THE PROBLEM&lt;/div&gt;" style="text;html=1;whiteSpace=wrap;overflow=visible;align=left;verticalAlign=top;fontFamily=Arial;fontSize=11.5;fontColor=#345746;fontStyle=1;spacing=0;spacingLeft=0;spacingRight=0;spacingTop=0;spacingBottom=0;strokeColor=none;fillColor=none;" vertex="1" parent="screen-566"><mxGeometry x="48.0" y="360.0" width="500.0" height="16.0" as="geometry"/></mxCell><mxCell id="screen-582" value="&lt;div style=&quot;line-height:1.15;&quot;&gt;You can’t tell how clothes fit until you try them on.&lt;/div&gt;" style="text;html=1;whiteSpace=wrap;overflow=visible;align=left;verticalAlign=top;fontFamily=Georgia;fontSize=36;fontColor=#243C32;fontStyle=0;spacing=0;spacingLeft=0;spacingRight=0;spacingTop=0;spacingBottom=0;strokeColor=none;fillColor=none;" vertex="1" parent="screen-566"><mxGeometry x="48.0" y="384.0" width="760.0" height="90.0" as="geometry"/></mxCell><mxCell id="screen-583" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FBF9F6;strokeColor=#D5CFC3;strokeWidth=1;" vertex="1" parent="screen-566"><mxGeometry x="48.0" y="500.0" width="384.0" height="170.0" as="geometry"/></mxCell><mxCell id="screen-584" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#A66B45;strokeColor=none;strokeWidth=1;" vertex="1" parent="screen-566"><mxGeometry x="48.0" y="500.0" width="384.0" height="3.0" as="geometry"/></mxCell><mxCell id="screen-585" value="45%" style="text;html=1;whiteSpace=wrap;overflow=visible;align=left;verticalAlign=top;fontFamily=Georgia;fontSize=54;fontColor=#345746;fontStyle=0;spacing=0;spacingLeft=0;spacingRight=0;spacingTop=0;spacingBottom=0;strokeColor=none;fillColor=none;" vertex="1" parent="screen-566"><mxGeometry x="72.0" y="520.0" width="340.0" height="64.0" as="geometry"/></mxCell><mxCell id="screen-586" value="&lt;div style=&quot;line-height:1.5;&quot;&gt;of clothing returns were caused by poor fit in 2022. &lt;span style=&quot;color:#345746&quot;&gt;&lt;u&gt;[1]&lt;/u&gt;&lt;/span&gt;&lt;/div&gt;" style="text;html=1;whiteSpace=wrap;overflow=visible;align=left;verticalAlign=top;fontFamily=Arial;fontSize=14;fontColor=#4F5A53;fontStyle=0;spacing=0;spacingLeft=0;spacingRight=0;spacingTop=0;spacingBottom=0;strokeColor=none;fillColor=none;" vertex="1" parent="screen-566"><mxGeometry x="72.0" y="594.0" width="330.0" height="50.0" as="geometry"/></mxCell><mxCell id="screen-587" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FBF9F6;strokeColor=#D5CFC3;strokeWidth=1;" vertex="1" parent="screen-566"><mxGeometry x="448.0" y="500.0" width="384.0" height="170.0" as="geometry"/></mxCell><mxCell id="screen-588" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#A66B45;strokeColor=none;strokeWidth=1;" vertex="1" parent="screen-566"><mxGeometry x="448.0" y="500.0" width="384.0" height="3.0" as="geometry"/></mxCell><mxCell id="screen-589" value="61%" style="text;html=1;whiteSpace=wrap;overflow=visible;align=left;verticalAlign=top;fontFamily=Georgia;fontSize=54;fontColor=#345746;fontStyle=0;spacing=0;spacingLeft=0;spacingRight=0;spacingTop=0;spacingBottom=0;strokeColor=none;fillColor=none;" vertex="1" parent="screen-566"><mxGeometry x="472.0" y="520.0" width="340.0" height="64.0" as="geometry"/></mxCell><mxCell id="screen-590" value="&lt;div style=&quot;line-height:1.5;&quot;&gt;of shoppers named poor fit as a main reason they return items. &lt;span style=&quot;color:#345746&quot;&gt;&lt;u&gt;[2]&lt;/u&gt;&lt;/span&gt;&lt;/div&gt;" style="text;html=1;whiteSpace=wrap;overflow=visible;align=left;verticalAlign=top;fontFamily=Arial;fontSize=14;fontColor=#4F5A53;fontStyle=0;spacing=0;spacingLeft=0;spacingRight=0;spacingTop=0;spacingBottom=0;strokeColor=none;fillColor=none;" vertex="1" parent="screen-566"><mxGeometry x="472.0" y="594.0" width="330.0" height="50.0" as="geometry"/></mxCell><mxCell id="screen-591" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FBF9F6;strokeColor=#D5CFC3;strokeWidth=1;" vertex="1" parent="screen-566"><mxGeometry x="848.0" y="500.0" width="384.0" height="170.0" as="geometry"/></mxCell><mxCell id="screen-592" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#A66B45;strokeColor=none;strokeWidth=1;" vertex="1" parent="screen-566"><mxGeometry x="848.0" y="500.0" width="384.0" height="3.0" as="geometry"/></mxCell><mxCell id="screen-593" value="1 truck" style="text;html=1;whiteSpace=wrap;overflow=visible;align=left;verticalAlign=top;fontFamily=Georgia;fontSize=54;fontColor=#345746;fontStyle=0;spacing=0;spacingLeft=0;spacingRight=0;spacingTop=0;spacingBottom=0;strokeColor=none;fillColor=none;" vertex="1" parent="screen-566"><mxGeometry x="872.0" y="520.0" width="340.0" height="64.0" as="geometry"/></mxCell><mxCell id="screen-594" value="&lt;div style=&quot;line-height:1.5;&quot;&gt;of textiles is landfilled or burned every second, worldwide. &lt;span style=&quot;color:#345746&quot;&gt;&lt;u&gt;[11]&lt;/u&gt;&lt;/span&gt;&lt;/div&gt;" style="text;html=1;whiteSpace=wrap;overflow=visible;align=left;verticalAlign=top;fontFamily=Arial;fontSize=14;fontColor=#4F5A53;fontStyle=0;spacing=0;spacingLeft=0;spacingRight=0;spacingTop=0;spacingBottom=0;strokeColor=none;fillColor=none;" vertex="1" parent="screen-566"><mxGeometry x="872.0" y="594.0" width="330.0" height="50.0" as="geometry"/></mxCell><mxCell id="screen-595" value="&lt;div style=&quot;letter-spacing:1.5px;&quot;&gt;TWO TECHNOLOGIES&lt;/div&gt;" style="text;html=1;whiteSpace=wrap;overflow=visible;align=left;verticalAlign=top;fontFamily=Arial;fontSize=11.5;fontColor=#345746;fontStyle=1;spacing=0;spacingLeft=0;spacingRight=0;spacingTop=0;spacingBottom=0;strokeColor=none;fillColor=none;" vertex="1" parent="screen-566"><mxGeometry x="48.0" y="720.0" width="500.0" height="16.0" as="geometry"/></mxCell><mxCell id="screen-596" value="AR shows it live. AI paints a picture." style="text;html=1;whiteSpace=wrap;overflow=visible;align=left;verticalAlign=top;fontFamily=Georgia;fontSize=40;fontColor=#243C32;fontStyle=0;spacing=0;spacingLeft=0;spacingRight=0;spacingTop=0;spacingBottom=0;strokeColor=none;fillColor=none;" vertex="1" parent="screen-566"><mxGeometry x="48.0" y="744.0" width="900.0" height="50.0" as="geometry"/></mxCell><mxCell id="screen-597" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FBF9F6;strokeColor=#D5CFC3;strokeWidth=1;" vertex="1" parent="screen-566"><mxGeometry x="48.0" y="820.0" width="584.0" height="520.0" as="geometry"/></mxCell><mxCell id="screen-598" value="AR try-on" style="text;html=1;whiteSpace=wrap;overflow=visible;align=left;verticalAlign=top;fontFamily=Georgia;fontSize=28;fontColor=#243C32;fontStyle=0;spacing=0;spacingLeft=0;spacingRight=0;spacingTop=0;spacingBottom=0;strokeColor=none;fillColor=none;" vertex="1" parent="screen-566"><mxGeometry x="76.0" y="846.0" width="520.0" height="34.0" as="geometry"/></mxCell><mxCell id="screen-599" value="&lt;div style=&quot;line-height:1.5;&quot;&gt;Your live camera view, with clothes drawn on top as you move.&lt;/div&gt;" style="text;html=1;whiteSpace=wrap;overflow=visible;align=left;verticalAlign=top;fontFamily=Arial;fontSize=14.5;fontColor=#4F5A53;fontStyle=0;spacing=0;spacingLeft=0;spacingRight=0;spacingTop=0;spacingBottom=0;strokeColor=none;fillColor=none;" vertex="1" parent="screen-566"><mxGeometry x="76.0" y="888.0" width="520.0" height="40.0" as="geometry"/></mxCell><mxCell id="screen-600" value="1" style="ellipse;whiteSpace=wrap;html=1;fillColor=#345746;strokeColor=none;strokeWidth=1;fontColor=#F6F3EC;fontSize=13;fontStyle=1;fontFamily=Arial;" vertex="1" parent="screen-566"><mxGeometry x="76.0" y="948.0" width="28.0" height="28.0" as="geometry"/></mxCell><mxCell id="screen-601" value="Camera" style="text;html=1;whiteSpace=wrap;overflow=visible;align=left;verticalAlign=top;fontFamily=Arial;fontSize=15;fontColor=#243C32;fontStyle=1;spacing=0;spacingLeft=0;spacingRight=0;spacingTop=0;spacingBottom=0;strokeColor=none;fillColor=none;" vertex="1" parent="screen-566"><mxGeometry x="118.0" y="950.0" width="480.0" height="22.0" as="geometry"/></mxCell><mxCell id="screen-602" value="&lt;div style=&quot;line-height:1.45;&quot;&gt;The page opens your phone or laptop camera.&lt;/div&gt;" style="text;html=1;whiteSpace=wrap;overflow=visible;align=left;verticalAlign=top;fontFamily=Arial;fontSize=14;fontColor=#4F5A53;fontStyle=0;spacing=0;spacingLeft=0;spacingRight=0;spacingTop=0;spacingBottom=0;strokeColor=none;fillColor=none;" vertex="1" parent="screen-566"><mxGeometry x="118.0" y="974.0" width="480.0" height="40.0" as="geometry"/></mxCell><mxCell id="screen-603" value="2" style="ellipse;whiteSpace=wrap;html=1;fillColor=#345746;strokeColor=none;strokeWidth=1;fontColor=#F6F3EC;fontSize=13;fontStyle=1;fontFamily=Arial;" vertex="1" parent="screen-566"><mxGeometry x="76.0" y="1022.0" width="28.0" height="28.0" as="geometry"/></mxCell><mxCell id="screen-604" value="Body tracking" style="text;html=1;whiteSpace=wrap;overflow=visible;align=left;verticalAlign=top;fontFamily=Arial;fontSize=15;fontColor=#243C32;fontStyle=1;spacing=0;spacingLeft=0;spacingRight=0;spacingTop=0;spacingBottom=0;strokeColor=none;fillColor=none;" vertex="1" parent="screen-566"><mxGeometry x="118.0" y="1024.0" width="480.0" height="22.0" as="geometry"/></mxCell><mxCell id="screen-605" value="&lt;div style=&quot;line-height:1.45;&quot;&gt;A model finds shoulders, elbows, hips and knees in every frame.&lt;/div&gt;" style="text;html=1;whiteSpace=wrap;overflow=visible;align=left;verticalAlign=top;fontFamily=Arial;fontSize=14;fontColor=#4F5A53;fontStyle=0;spacing=0;spacingLeft=0;spacingRight=0;spacingTop=0;spacingBottom=0;strokeColor=none;fillColor=none;" vertex="1" parent="screen-566"><mxGeometry x="118.0" y="1048.0" width="480.0" height="40.0" as="geometry"/></mxCell><mxCell id="screen-606" value="3" style="ellipse;whiteSpace=wrap;html=1;fillColor=#345746;strokeColor=none;strokeWidth=1;fontColor=#F6F3EC;fontSize=13;fontStyle=1;fontFamily=Arial;" vertex="1" parent="screen-566"><mxGeometry x="76.0" y="1096.0" width="28.0" height="28.0" as="geometry"/></mxCell><mxCell id="screen-607" value="Fitting" style="text;html=1;whiteSpace=wrap;overflow=visible;align=left;verticalAlign=top;fontFamily=Arial;fontSize=15;fontColor=#243C32;fontStyle=1;spacing=0;spacingLeft=0;spacingRight=0;spacingTop=0;spacingBottom=0;strokeColor=none;fillColor=none;" vertex="1" parent="screen-566"><mxGeometry x="118.0" y="1098.0" width="480.0" height="22.0" as="geometry"/></mxCell><mxCell id="screen-608" value="&lt;div style=&quot;line-height:1.45;&quot;&gt;A 3D model of the garment is moved to match those points.&lt;/div&gt;" style="text;html=1;whiteSpace=wrap;overflow=visible;align=left;verticalAlign=top;fontFamily=Arial;fontSize=14;fontColor=#4F5A53;fontStyle=0;spacing=0;spacingLeft=0;spacingRight=0;spacingTop=0;spacingBottom=0;strokeColor=none;fillColor=none;" vertex="1" parent="screen-566"><mxGeometry x="118.0" y="1122.0" width="480.0" height="40.0" as="geometry"/></mxCell><mxCell id="screen-609" value="4" style="ellipse;whiteSpace=wrap;html=1;fillColor=#345746;strokeColor=none;strokeWidth=1;fontColor=#F6F3EC;fontSize=13;fontStyle=1;fontFamily=Arial;" vertex="1" parent="screen-566"><mxGeometry x="76.0" y="1170.0" width="28.0" height="28.0" as="geometry"/></mxCell><mxCell id="screen-610" value="Drawing" style="text;html=1;whiteSpace=wrap;overflow=visible;align=left;verticalAlign=top;fontFamily=Arial;fontSize=15;fontColor=#243C32;fontStyle=1;spacing=0;spacingLeft=0;spacingRight=0;spacingTop=0;spacingBottom=0;strokeColor=none;fillColor=none;" vertex="1" parent="screen-566"><mxGeometry x="118.0" y="1172.0" width="480.0" height="22.0" as="geometry"/></mxCell><mxCell id="screen-611" value="&lt;div style=&quot;line-height:1.45;&quot;&gt;The garment is redrawn over the video many times a second.&lt;/div&gt;" style="text;html=1;whiteSpace=wrap;overflow=visible;align=left;verticalAlign=top;fontFamily=Arial;fontSize=14;fontColor=#4F5A53;fontStyle=0;spacing=0;spacingLeft=0;spacingRight=0;spacingTop=0;spacingBottom=0;strokeColor=none;fillColor=none;" vertex="1" parent="screen-566"><mxGeometry x="118.0" y="1196.0" width="480.0" height="40.0" as="geometry"/></mxCell><mxCell id="screen-612" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#D5CFC3;strokeColor=none;strokeWidth=1;" vertex="1" parent="screen-566"><mxGeometry x="76.0" y="1252.0" width="528.0" height="1.0" as="geometry"/></mxCell><mxCell id="screen-613" value="" style="shape=image;html=1;imageAspect=0;image=data:image/svg+xml,PHN2ZyB4bWxucz0iaHR0cDovL3d3dy53My5vcmcvMjAwMC9zdmciIHdpZHRoPSIyNCIgaGVpZ2h0PSIyNCIgdmlld0JveD0iMCAwIDI0IDI0IiBmaWxsPSJub25lIiBzdHJva2U9IiMzNDU3NDYiIHN0cm9rZS13aWR0aD0iMS44IiBzdHJva2UtbGluZWNhcD0icm91bmQiIHN0cm9rZS1saW5lam9pbj0icm91bmQiPjxwYXRoIGQ9Ik0yMCA2IDkgMTdsLTUtNSIvPjwvc3ZnPg==;" vertex="1" parent="screen-566"><mxGeometry x="76.0" y="1270.0" width="18.0" height="18.0" as="geometry"/></mxCell><mxCell id="screen-614" value="&lt;b&gt;Good:&lt;/b&gt; Instant and interactive." style="text;html=1;whiteSpace=wrap;overflow=visible;align=left;verticalAlign=top;fontFamily=Arial;fontSize=14;fontColor=#243C32;fontStyle=0;spacing=0;spacingLeft=0;spacingRight=0;spacingTop=0;spacingBottom=0;strokeColor=none;fillColor=none;" vertex="1" parent="screen-566"><mxGeometry x="102.0" y="1268.0" width="500.0" height="22.0" as="geometry"/></mxCell><mxCell id="screen-615" value="" style="shape=image;html=1;imageAspect=0;image=data:image/svg+xml,;" vertex="1" parent="screen-566"><mxGeometry x="76.0" y="1300.0" width="18.0" height="18.0" as="geometry"/></mxCell><mxCell id="screen-616" value="&lt;b&gt;Hard:&lt;/b&gt; Needs a 3D model of every item." style="text;html=1;whiteSpace=wrap;overflow=visible;align=left;verticalAlign=top;fontFamily=Arial;fontSize=14;fontColor=#243C32;fontStyle=0;spacing=0;spacingLeft=0;spacingRight=0;spacingTop=0;spacingBottom=0;strokeColor=none;fillColor=none;" vertex="1" parent="screen-566"><mxGeometry x="102.0" y="1298.0" width="500.0" height="22.0" as="geometry"/></mxCell><mxCell id="screen-617" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FBF9F6;strokeColor=#D5CFC3;strokeWidth=1;" vertex="1" parent="screen-566"><mxGeometry x="648.0" y="820.0" width="584.0" height="520.0" as="geometry"/></mxCell><mxCell id="screen-618" value="AI (generative) try-on" style="text;html=1;whiteSpace=wrap;overflow=visible;align=left;verticalAlign=top;fontFamily=Georgia;fontSize=28;fontColor=#243C32;fontStyle=0;spacing=0;spacingLeft=0;spacingRight=0;spacingTop=0;spacingBottom=0;strokeColor=none;fillColor=none;" vertex="1" parent="screen-566"><mxGeometry x="676.0" y="846.0" width="520.0" height="34.0" as="geometry"/></mxCell><mxCell id="screen-619" value="&lt;div style=&quot;line-height:1.5;&quot;&gt;A still image of a person wearing the garment, made by an AI model.&lt;/div&gt;" style="text;html=1;whiteSpace=wrap;overflow=visible;align=left;verticalAlign=top;fontFamily=Arial;fontSize=14.5;fontColor=#4F5A53;fontStyle=0;spacing=0;spacingLeft=0;spacingRight=0;spacingTop=0;spacingBottom=0;strokeColor=none;fillColor=none;" vertex="1" parent="screen-566"><mxGeometry x="676.0" y="888.0" width="520.0" height="40.0" as="geometry"/></mxCell><mxCell id="screen-620" value="1" style="ellipse;whiteSpace=wrap;html=1;fillColor=#345746;strokeColor=none;strokeWidth=1;fontColor=#F6F3EC;fontSize=13;fontStyle=1;fontFamily=Arial;" vertex="1" parent="screen-566"><mxGeometry x="676.0" y="948.0" width="28.0" height="28.0" as="geometry"/></mxCell><mxCell id="screen-621" value="Two photos" style="text;html=1;whiteSpace=wrap;overflow=visible;align=left;verticalAlign=top;fontFamily=Arial;fontSize=15;fontColor=#243C32;fontStyle=1;spacing=0;spacingLeft=0;spacingRight=0;spacingTop=0;spacingBottom=0;strokeColor=none;fillColor=none;" vertex="1" parent="screen-566"><mxGeometry x="718.0" y="950.0" width="480.0" height="22.0" as="geometry"/></mxCell><mxCell id="screen-622" value="&lt;div style=&quot;line-height:1.45;&quot;&gt;One of the person, one of the garment.&lt;/div&gt;" style="text;html=1;whiteSpace=wrap;overflow=visible;align=left;verticalAlign=top;fontFamily=Arial;fontSize=14;fontColor=#4F5A53;fontStyle=0;spacing=0;spacingLeft=0;spacingRight=0;spacingTop=0;spacingBottom=0;strokeColor=none;fillColor=none;" vertex="1" parent="screen-566"><mxGeometry x="718.0" y="974.0" width="480.0" height="40.0" as="geometry"/></mxCell><mxCell id="screen-623" value="2" style="ellipse;whiteSpace=wrap;html=1;fillColor=#345746;strokeColor=none;strokeWidth=1;fontColor=#F6F3EC;fontSize=13;fontStyle=1;fontFamily=Arial;" vertex="1" parent="screen-566"><mxGeometry x="676.0" y="1022.0" width="28.0" height="28.0" as="geometry"/></mxCell><mxCell id="screen-624" value="Understanding the person" style="text;html=1;whiteSpace=wrap;overflow=visible;align=left;verticalAlign=top;fontFamily=Arial;fontSize=15;fontColor=#243C32;fontStyle=1;spacing=0;spacingLeft=0;spacingRight=0;spacingTop=0;spacingBottom=0;strokeColor=none;fillColor=none;" vertex="1" parent="screen-566"><mxGeometry x="718.0" y="1024.0" width="480.0" height="22.0" as="geometry"/></mxCell><mxCell id="screen-625" value="&lt;div style=&quot;line-height:1.45;&quot;&gt;Estimates pose and removes the clothes they are wearing.&lt;/div&gt;" style="text;html=1;whiteSpace=wrap;overflow=visible;align=left;verticalAlign=top;fontFamily=Arial;fontSize=14;fontColor=#4F5A53;fontStyle=0;spacing=0;spacingLeft=0;spacingRight=0;spacingTop=0;spacingBottom=0;strokeColor=none;fillColor=none;" vertex="1" parent="screen-566"><mxGeometry x="718.0" y="1048.0" width="480.0" height="40.0" as="geometry"/></mxCell><mxCell id="screen-626" value="3" style="ellipse;whiteSpace=wrap;html=1;fillColor=#345746;strokeColor=none;strokeWidth=1;fontColor=#F6F3EC;fontSize=13;fontStyle=1;fontFamily=Arial;" vertex="1" parent="screen-566"><mxGeometry x="676.0" y="1096.0" width="28.0" height="28.0" as="geometry"/></mxCell><mxCell id="screen-627" value="Generating" style="text;html=1;whiteSpace=wrap;overflow=visible;align=left;verticalAlign=top;fontFamily=Arial;fontSize=15;fontColor=#243C32;fontStyle=1;spacing=0;spacingLeft=0;spacingRight=0;spacingTop=0;spacingBottom=0;strokeColor=none;fillColor=none;" vertex="1" parent="screen-566"><mxGeometry x="718.0" y="1098.0" width="480.0" height="22.0" as="geometry"/></mxCell><mxCell id="screen-628" value="&lt;div style=&quot;line-height:1.45;&quot;&gt;A diffusion model creates a new photo of them wearing it.&lt;/div&gt;" style="text;html=1;whiteSpace=wrap;overflow=visible;align=left;verticalAlign=top;fontFamily=Arial;fontSize=14;fontColor=#4F5A53;fontStyle=0;spacing=0;spacingLeft=0;spacingRight=0;spacingTop=0;spacingBottom=0;strokeColor=none;fillColor=none;" vertex="1" parent="screen-566"><mxGeometry x="718.0" y="1122.0" width="480.0" height="40.0" as="geometry"/></mxCell><mxCell id="screen-629" value="4" style="ellipse;whiteSpace=wrap;html=1;fillColor=#345746;strokeColor=none;strokeWidth=1;fontColor=#F6F3EC;fontSize=13;fontStyle=1;fontFamily=Arial;" vertex="1" parent="screen-566"><mxGeometry x="676.0" y="1170.0" width="28.0" height="28.0" as="geometry"/></mxCell><mxCell id="screen-630" value="Training" style="text;html=1;whiteSpace=wrap;overflow=visible;align=left;verticalAlign=top;fontFamily=Arial;fontSize=15;fontColor=#243C32;fontStyle=1;spacing=0;spacingLeft=0;spacingRight=0;spacingTop=0;spacingBottom=0;strokeColor=none;fillColor=none;" vertex="1" parent="screen-566"><mxGeometry x="718.0" y="1172.0" width="480.0" height="22.0" as="geometry"/></mxCell><mxCell id="screen-631" value="&lt;div style=&quot;line-height:1.45;&quot;&gt;Learned from about 4 million image pairs.&lt;/div&gt;" style="text;html=1;whiteSpace=wrap;overflow=visible;align=left;verticalAlign=top;fontFamily=Arial;fontSize=14;fontColor=#4F5A53;fontStyle=0;spacing=0;spacingLeft=0;spacingRight=0;spacingTop=0;spacingBottom=0;strokeColor=none;fillColor=none;" vertex="1" parent="screen-566"><mxGeometry x="718.0" y="1196.0" width="480.0" height="40.0" as="geometry"/></mxCell><mxCell id="screen-632" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#D5CFC3;strokeColor=none;strokeWidth=1;" vertex="1" parent="screen-566"><mxGeometry x="676.0" y="1252.0" width="528.0" height="1.0" as="geometry"/></mxCell><mxCell id="screen-633" value="" style="shape=image;html=1;imageAspect=0;image=data:image/svg+xml,PHN2ZyB4bWxucz0iaHR0cDovL3d3dy53My5vcmcvMjAwMC9zdmciIHdpZHRoPSIyNCIgaGVpZ2h0PSIyNCIgdmlld0JveD0iMCAwIDI0IDI0IiBmaWxsPSJub25lIiBzdHJva2U9IiMzNDU3NDYiIHN0cm9rZS13aWR0aD0iMS44IiBzdHJva2UtbGluZWNhcD0icm91bmQiIHN0cm9rZS1saW5lam9pbj0icm91bmQiPjxwYXRoIGQ9Ik0yMCA2IDkgMTdsLTUtNSIvPjwvc3ZnPg==;" vertex="1" parent="screen-566"><mxGeometry x="676.0" y="1270.0" width="18.0" height="18.0" as="geometry"/></mxCell><mxCell id="screen-634" value="&lt;b&gt;Good:&lt;/b&gt; Very realistic folds and shadows." style="text;html=1;whiteSpace=wrap;overflow=visible;align=left;verticalAlign=top;fontFamily=Arial;fontSize=14;fontColor=#243C32;fontStyle=0;spacing=0;spacingLeft=0;spacingRight=0;spacingTop=0;spacingBottom=0;strokeColor=none;fillColor=none;" vertex="1" parent="screen-566"><mxGeometry x="702.0" y="1268.0" width="500.0" height="22.0" as="geometry"/></mxCell><mxCell id="screen-635" value="" style="shape=image;html=1;imageAspect=0;image=data:image/svg+xml,;" vertex="1" parent="screen-566"><mxGeometry x="676.0" y="1300.0" width="18.0" height="18.0" as="geometry"/></mxCe