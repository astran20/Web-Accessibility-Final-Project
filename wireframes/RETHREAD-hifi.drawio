nded=0;whiteSpace=wrap;html=1;fillColor=#FBF9F6;strokeColor=#D5CFC3;strokeWidth=1;" vertex="1" parent="screen-566"><mxGeometry x="48.0" y="1624.0" width="1184.0" height="48.0" as="geometry"/></mxCell><mxCell id="screen-652" value="Fit estimate" style="text;html=1;whiteSpace=wrap;overflow=visible;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=13.5;fontColor=#243C32;fontStyle=1;spacing=0;spacingLeft=0;spacingRight=0;spacingTop=0;spacingBottom=0;strokeColor=none;fillColor=none;" vertex="1" parent="screen-566"><mxGeometry x="66.0" y="1624.0" width="190.0" height="48.0" as="geometry"/></mxCell><mxCell id="screen-653" value="Compares the listed size with the model’s size." style="text;html=1;whiteSpace=wrap;overflow=visible;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=13.5;fontColor=#345746;fontStyle=0;spacing=0;spacingLeft=0;spacingRight=0;spacingTop=0;spacingBottom=0;strokeColor=none;fillColor=none;" vertex="1" parent="screen-566"><mxGeometry x="286.0" y="1624.0" width="430.0" height="48.0" as="geometry"/></mxCell><mxCell id="screen-654" value="Body and garment measurements, which listings rarely include." style="text;html=1;whiteSpace=wrap;overflow=visible;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=13.5;fontColor=#243C32;fontStyle=0;spacing=0;spacingLeft=0;spacingRight=0;spacingTop=0;spacingBottom=0;strokeColor=none;fillColor=none;" vertex="1" parent="screen-566"><mxGeometry x="746.0" y="1624.0" width="474.0" height="48.0" as="geometry"/></mxCell><mxCell id="screen-655" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F6F3EC;strokeColor=#D5CFC3;strokeWidth=1;" vertex="1" parent="screen-566"><mxGeometry x="48.0" y="1672.0" width="1184.0" height="48.0" as="geometry"/></mxCell><mxCell id="screen-656" value="Style assistant" style="text;html=1;whiteSpace=wrap;overflow=visible;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=13.5;fontColor=#243C32;fontStyle=1;spacing=0;spacingLeft=0;spacingRight=0;spacingTop=0;spacingBottom=0;strokeColor=none;fillColor=none;" vertex="1" parent="screen-566"><mxGeometry x="66.0" y="1672.0" width="190.0" height="48.0" as="geometry"/></mxCell><mxCell id="screen-657" value="Keyword matching over the 8 sample pieces." style="text;html=1;whiteSpace=wrap;overflow=visible;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=13.5;fontColor=#345746;fontStyle=0;spacing=0;spacingLeft=0;spacingRight=0;spacingTop=0;spacingBottom=0;strokeColor=none;fillColor=none;" vertex="1" parent="screen-566"><mxGeometry x="286.0" y="1672.0" width="430.0" height="48.0" as="geometry"/></mxCell><mxCell id="screen-658" value="A language model plus recommendations from many shoppers." style="text;html=1;whiteSpace=wrap;overflow=visible;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=13.5;fontColor=#243C32;fontStyle=0;spacing=0;spacingLeft=0;spacingRight=0;spacingTop=0;spacingBottom=0;strokeColor=none;fillColor=none;" vertex="1" parent="screen-566"><mxGeometry x="746.0" y="1672.0" width="474.0" height="48.0" as="geometry"/></mxCell><mxCell id="screen-659" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E9E3D7;strokeColor=none;strokeWidth=1;" vertex="1" parent="screen-566"><mxGeometry x="0.0" y="1760.0" width="1280.0" height="148.0" as="geometry"/></mxCell><mxCell id="screen-660" value="" style="shape=image;html=1;imageAspect=0;image=data:image/svg+xml,;" vertex="1" parent="screen-566"><mxGeometry x="48.0" y="1790.0" width="32.0" height="32.0" as="geometry"/></mxCell><mxCell id="screen-661" value="&lt;div style=&quot;letter-spacing:1.5px;&quot;&gt;SUSTAINABILITY&lt;/div&gt;" style="text;html=1;whiteSpace=wrap;overflow=visible;align=left;verticalAlign=top;fontFamily=Arial;fontSize=11.5;fontColor=#345746;fontStyle=1;spacing=0;spacingLeft=0;spacingRight=0;spacingTop=0;spacingBottom=0;strokeColor=none;fillColor=none;" vertex="1" parent="screen-566"><mxGeometry x="96.0" y="1790.0" width="500.0" height="16.0" as="geometry"/></mxCell><mxCell id="screen-662" value="Fewer wasted trips. More clothes kept in use." style="text;html=1;whiteSpace=wrap;overflow=visible;align=left;verticalAlign=top;fontFamily=Georgia;fontSize=30;fontColor=#243C32;fontStyle=0;spacing=0;spacingLeft=0;spacingRight=0;spacingTop=0;spacingBottom=0;strokeColor=none;fillColor=none;" vertex="1" parent="screen-566"><mxGeometry x="96.0" y="1812.0" width="700.0" height="40.0" as="geometry"/></mxCell><mxCell id="screen-663" value="Try-on means you only travel for pieces likely to fit, and every secondhand purchase keeps a piece out of landfill a little longer." style="text;html=1;whiteSpace=wrap;overflow=visible;align=left;verticalAlign=top;fontFamily=Arial;fontSize=14.5;fontColor=#4F5A53;fontStyle=0;spacing=0;spacingLeft=0;spacingRight=0;spacingTop=0;spacingBottom=0;strokeColor=none;fillColor=none;" vertex="1" parent="screen-566"><mxGeometry x="96.0" y="1856.0" width="1000.0" height="40.0" as="geometry"/></mxCell><mxCell id="screen-664" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#D5CFC3;strokeColor=none;strokeWidth=1;" vertex="1" parent="screen-566"><mxGeometry x="0.0" y="1908.0" width="1280.0" height="1.0" as="geometry"/></mxCell><mxCell id="screen-665" value="&lt;div style=&quot;letter-spacing:2.6px;&quot;&gt;RETHREAD&lt;span style=&quot;color:#A66B45&quot;&gt;.&lt;/span&gt;&lt;/div&gt;" style="text;html=1;whiteSpace=wrap;overflow=visible;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=15;fontColor=#345746;fontStyle=1;spacing=0;spacingLeft=0;spacingRight=0;spacingTop=0;spacingBottom=0;strokeColor=none;fillColor=none;" vertex="1" parent="screen-566"><mxGeometry x="48.0" y="1908.0" width="140.0" height="92.0" as="geometry"/></mxCell><mxCell id="screen-666" value="Find your next favorite, close to home." style="text;html=1;whiteSpace=wrap;overflow=visible;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=14;fontColor=#4F5A53;fontStyle=0;spacing=0;spacingLeft=0;spacingRight=0;spacingTop=0;spacingBottom=0;strokeColor=none;fillColor=none;" vertex="1" parent="screen-566"><mxGeometry x="190.0" y="1908.0" width="400.0" height="92.0" as="geometry"/></mxCell><mxCell id="screen-667" value="Classroom prototype · Sample listings only" style="text;html=1;whiteSpace=wrap;overflow=visible;align=right;verticalAlign=middle;fontFamily=Arial;fontSize=12.5;fontColor=#4F5A53;fontStyle=0;spacing=0;spacingLeft=0;spacingRight=0;spacingTop=0;spacingBottom=0;strokeColor=none;fillColor=none;" vertex="1" parent="screen-566"><mxGeometry x="872.0" y="1908.0" width="360.0" height="92.0" as="geometry"/></mxCell><mxCell id="screen-668" value="&lt;b&gt;From lo-fi:&lt;/b&gt; the placeholder stats are now Ismael’s sourced numbers with citation links. The comparison table is the main thing graders look for: it says exactly what is simulated." style="shape=note;size=16;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;align=left;verticalAlign=top;spacing=14;fontFamily=Arial;fontSize=14;fontColor=#3D3420;" vertex="1" parent="1"><mxGeometry x="8640.0" y="2030.0" width="600.0" height="150.0" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="emptye-201" name="3 Empty, error and loading states"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="2200" pageHeight="2800" background="#FFFFFF" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="emptye-1" value="Empty, error and loading states" style="text;html=1;whiteSpace=wrap;overflow=visible;align=left;verticalAlign=top;fontFamily=Georgia;fontSize=44;fontColor=#243C32;fontStyle=0;spacing=0;spacingLeft=0;spacingRight=0;spacingTop=0;spacingBottom=0;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="0.0" y="-140.0" width="2000.0" height="60.0" as="geometry"/></mxCell><mxCell id="emptye-2" value="Each card is the part of the page that changes. Everything else on the page stays as shown on the Screens page." styl