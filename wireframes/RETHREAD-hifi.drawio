&lt;b&gt;Added:&lt;/b&gt; an Undo toast after removing a piece (H3 user control), and the empty state is on the States page." style="shape=note;size=16;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;align=left;verticalAlign=top;spacing=14;fontFamily=Arial;fontSize=14;fontColor=#3D3420;" vertex="1" parent="1"><mxGeometry x="2880.0" y="1270.0" width="600.0" height="190.0" as="geometry"/></mxCell><mxCell id="screen-273" value="3 · Virtual try-on (demo)" style="text;html=1;whiteSpace=wrap;overflow=visible;align=left;verticalAlign=top;fontFamily=Georgia;fontSize=26;fontColor=#1D1D1B;fontStyle=0;spacing=0;spacingLeft=0;spacingRight=0;spacingTop=0;spacingBottom=0;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="4320.0" y="-64.0" width="1280.0" height="34.0" as="geometry"/></mxCell><mxCell id="screen-274" value="virtual-try-on.html · interaction 3" style="text;html=1;whiteSpace=wrap;overflow=visible;align=left;verticalAlign=top;fontFamily=Arial;fontSize=13;fontColor=#6B6B66;fontStyle=0;spacing=0;spacingLeft=0;spacingRight=0;spacingTop=0;spacingBottom=0;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="4320.0" y="-30.0" width="1280.0" height="20.0" as="geometry"/></mxCell><mxCell id="screen-275" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F6F3EC;strokeColor=#C9C2B5;strokeWidth=1;container=1;collapsible=0;recursiveResize=0;shadow=1;" vertex="1" parent="1"><mxGeometry x="4320.0" y="0.0" width="1280.0" height="2160.0" as="geometry"/></mxCell><mxCell id="screen-276" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F6F3EC;strokeColor=none;strokeWidth=1;" vertex="1" parent="screen-275"><mxGeometry x="0.0" y="0.0" width="1280.0" height="78.0" as="geometry"/></mxCell><mxCell id="screen-277" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#D5CFC3;strokeColor=none;strokeWidth=1;" vertex="1" parent="screen-275"><mxGeometry x="0.0" y="77.0" width="1280.0" height="1.0" as="geometry"/></mxCell><