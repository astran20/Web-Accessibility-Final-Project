e=&quot;line-height:1.4;&quot;&gt;48px&lt;br&gt;&lt;span style=&quot;color:#4F5A53&quot;&gt;--rt-space-5&lt;/span&gt;&lt;/div&gt;" style="text;html=1;whiteSpace=wrap;overflow=visible;align=left;verticalAlign=top;fontFamily=Arial;fontSize=12;fontColor=#243C32;fontStyle=0;spacing=0;spacingLeft=0;spacingRight=0;spacingTop=0;spacingBottom=0;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="520.0" y="1506.0" width="120.0" height="36.0" as="geometry"/></mxCell><mxCell id="styleg-237" value="&lt;div style=&quot;line-height:1.55;&quot;&gt;Desktop frames are 1280 wide with 48px side margins (1184 content). Product grid: 4 columns, 20px gutter, 3:4 photos. Corners are 2px everywhere except round controls (heart, step badges, chips, status pills). Touch targets are at least 44px.&lt;/div&gt;" style="text;html=1;whiteSpace=wrap;overflow=visible;align=left;verticalAlign=top;fontFamily=Arial;fontSize=14;fontColor=#4F5A53;fontStyle=0;spacing=0;spacingLeft=0;spacingRight=0;spacingTop=0;spacingBottom=0;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="680.0" y="1446.0" width="820.0" height="120.0" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="screen-669" name="2 Screens"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="9600" pageHeight="2400" background="#FFFFFF" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="screen-1" value="Main flow: browse, save, try on, book, manage" style="text;html=1;whiteSpace=wrap;overflow=visible;align=left;verticalAlign=top;fontFamily=Georgia;fontSize=44;fontColor=#243C32;fontStyle=0;spacing=0;spacingLeft=0;spacingRight=0;spacingTop=0;spacingBottom=0;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="0.0" y="-220.0" width="4000.0" height="60.0" as="geometry"/></mxCell><mxCell id="screen-2" value="Hi-fi versions of the lo-fi boards in wireframe